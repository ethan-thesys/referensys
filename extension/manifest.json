{
  "manifest_version": 3,
  "name": "Referensys",
  "description": "Turn any task into a step-by-step SOP with screenshots, titles and instructions. Saves to your Google Drive.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Referensys: record an SOP",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "capture-step": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Take a step now (works while another app is in front)",
      "global": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
